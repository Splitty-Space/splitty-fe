{
  "mcpServers": {
    "chrome-devtools": {
      "command": "node",
      "args": [
        "node_modules/chrome-devtools-mcp/out/Default/gen/src/bin/chrome-devtools-mcp.js",
        "--categoryExperimentalThirdParty=true",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "next-devtools": {
      "command": "node",
      "args": ["node_modules/next-devtools-mcp/dist/index.js"],
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    }
  }
}
